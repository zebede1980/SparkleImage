# Local GPU: ComfyUI on the home PC, through comfy-gateway (the same gateway and
# key CardGenV2 uses). This is what restores photos; leave blank to use cloud only.
COMFY_URL=https://comfy.example.com
COMFY_API_KEY=

# Cloud (nano-gpt): optional extra candidates, and the Mark & remove tool.
IMAGE_API_URL=https://nano-gpt.com/api/v1
IMAGE_API_KEY=
# Model for Mark & remove. seedream-v4.5: not content-filtered, keeps aspect ratio.
EDIT_MODEL=seedream-v4.5

# Set both. The app is reachable from the internet behind NPM, and its Settings
# can point the GPU anywhere — never run it without a login.
AUTH_USERNAME=
AUTH_PASSWORD=

# Match the host user so bind-mounted ./data stays writable.
APP_UID=1000
APP_GID=1000
