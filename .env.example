# Image API (nano-gpt or any OpenAI-compatible image host)
IMAGE_API_URL=https://nano-gpt.com/api/v1
IMAGE_API_KEY=your_api_key_here

# seedream-v4.5 is the default edit model: not content-filtered (photographs of
# real people are rejected far less often), free-form output resolutions so the
# result keeps the source photo's aspect ratio, and up to 16.8MP.
EDIT_MODEL=seedream-v4.5

# A dedicated upscaler — never a generative edit model.
UPSCALE_MODEL=clarity-ai-pro-upscaler

# Set both to require a login before the UI will open.
AUTH_USERNAME=
AUTH_PASSWORD=

# Match the host user so bind-mounted ./data stays writable.
APP_UID=1000
APP_GID=1000
